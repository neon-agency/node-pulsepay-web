{
  "name": "pulsepay-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "Frontend e API Node para intermediação de pagamentos Pix",
  "scripts": {
    "dev": "node server.js",
    "start": "node server.js",
    "dev:api": "node src/server.js",
