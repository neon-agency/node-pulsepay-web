FRONTEND_HOST=0.0.0.0
FRONTEND_PORT=4173
FRONTEND_API_BASE_URL=http://localhost:8080

# API Node (PostgreSQL)
API_HOST=0.0.0.0
API_PORT=3001
DATABASE_URL=postgresql://user:password@localhost:5432/pulsepay
DB_SSL=false
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=pulsepay
DB_SSL_MODE=disable
DB_DRIVER=postgres
API_LOGIN_EMAIL=admin@pulsepay.com
API_LOGIN_PASSWORD=pulsepay123
API_LOGIN_NAME=Administrador PulsePay
API_LOGIN_ROLE=admin
API_LOGIN_WHATSAPP_PHONE=5511999999999
GO_ZAP_SERVICE_URL=http://localhost:8080
SALES_NOTIFICATIONS_POLL_INTERVAL_MS=30000
PULSEPAY_ADMIN_URL=https://pulsepay.webutilidades.online
OPENAI_API_KEY=
OPENAI_RECEIPT_MODEL=gpt-4.1-mini

# Bot/API integração interna (Vercel)
# Em produção, prefira usar a URL do deploy e uma chave interna fixa.
INTERNAL_API_BASE_URL=https://seu-projeto.vercel.app
INTERNAL_API_KEY=defina_uma_chave_forte_aqui

# Integrações externas do bot
WHATSAPP_SERVICE_URL=http://localhost:8082
PAYMENT_SERVICE_URL=https://go-payment-825906875083.europe-west1.run.app
PAYMENT_WEBHOOK_SECRET=defina_um_segredo_para_webhook
SUBSCRIPTION_PAYMENT_PROVIDER=efi
SUBSCRIPTION_PAYMENT_METHOD=pix

# Google Cloud Storage (comprovantes)
# Bucket onde os comprovantes serao armazenados (ex: pulsepay-prod-payment-proofs)
GCS_BUCKET=
# Opcional: credenciais em JSON (service account). Em producao, prefira usar GOOGLE_APPLICATION_CREDENTIALS
# com o arquivo montado no container/Cloud Run.
GOOGLE_APPLICATION_CREDENTIALS_JSON=
